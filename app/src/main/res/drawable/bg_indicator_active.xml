<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient circle with subtle stroke -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#36C6F8"
                android:centerColor="#7B82F6"
                android:endColor="#CB74EC" />
            <stroke
                android:width="1dp"
                android:color="#45FFFFFF" />
            <size android:width="13dp" android:height="13dp" />
        </shape>
    </item>
    <!-- Top-left glossy 3D highlight reflection -->
    <item
        android:left="2.5dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
