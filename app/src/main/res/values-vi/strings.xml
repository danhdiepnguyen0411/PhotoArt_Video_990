    <string name="prompt_style_cyber_move">Vũ công phong cách cyber chuyển động điêu luyện, viền neon rực rỡ, vệt sáng ma mị</string>
    <string name="prompt_style_street_vibes">Chân dung phong cách đường phố của bạn trẻ mặc streetwear thời thượng, tường graffiti nghệ thuật, ánh sáng hoàng hôn ấm áp</string>
    <string name="prompt_style_urban_renaissance">Cảnh quan đô thị phục hưng lúc chạng vạng, kiến trúc cổ điển hòa quyện cùng các tòa nhà chọc trời hiện đại, ánh sáng ấm, phong cách hội họa sắc nét</string>
    <string name="prompt_style_dreamy">Khung cảnh màu pastel mộng mơ với những đám mây mềm mại, cánh hoa bay lượn và ánh sáng lung linh, không khí huyền ảo, tranh minh họa thần tiên</string>
    <string name="prompt_style_vintage">Bức ảnh phim thập niên 1970 cổ điển về cặp đôi trên chuyến du ngoạn bên bờ biển, màu sắc hoài niệm, vệt sáng ánh kim, hạt phim hoài cổ</string>
    <string name="prompt_style_cyberpunk">Đô thị cyberpunk rực rỡ ánh đèn neon về đêm với xe bay, bảng hiệu holographic và đường phố ướt mưa, góc nhìn điện ảnh 8k</string>
    <string name="prompt_style_nature">Thác nước huyền bí ẩn mình giữa rừng thông rực rỡ ánh nắng ban mai, làn sương mờ ảo, tia sáng rực rỡ, ảnh thiên nhiên chân thực tuyệt đẹp</string>
    <string name="prompt_style_portrait">Chân dung điện ảnh sắc nét chân thực của cô gái giữa cánh đồng hoa nở rộ, ánh nắng dịu nhẹ, hiệu ứng xoá phông nghệ thuật, 8k</string>
    <string name="prompt_style_fantasy">Lâu đài kỳ ảo bay lơ lửng trên những tầng mây với tinh thể phát sáng và dải cực quang trên bầu trời, tranh nghệ thuật kỳ ảo hoành tráng</string>
    <string name="prompt_style_selfie">Bức ảnh selfie vui vẻ sành điệu của bạn trẻ với trang phục thời thượng, ánh sáng tự nhiên dịu nhẹ, phông nền tươi sáng, thẩm mỹ mạng xã hội hiện đại</string>
