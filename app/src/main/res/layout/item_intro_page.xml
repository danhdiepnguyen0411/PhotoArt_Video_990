<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Icon: lowered to marginTop 90dp, aligned to 32dp left margin matching design -->
    <ImageView
        android:id="@+id/ivIntroIcon"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="90dp"
        android:contentDescription="Intro Icon"
        android:scaleType="fitStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/icon_intro_1" />

    <!-- Title: royal navy #13388C, 34sp, heavy bold, 32dp left margin matching design -->
    <TextView
        android:id="@+id/tvIntroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/inter_black"
        android:gravity="start"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.02"
        android:textColor="#13388C"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivIntroIcon"
        tools:text="Gom ảnh,\ntạo video" />

    <!-- Description: soft slate blue #7A8FB8, 14sp, 32dp left margin matching design -->
    <TextView
        android:id="@+id/tvIntroDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="48dp"
        android:fontFamily="@font/inter_medium"
        android:gravity="start"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:textColor="#7A8FB8"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIntroTitle"
        tools:text="Biến những khoảnh khắc yêu thích\nthành video sống động chỉ trong vài giây." />

    <!-- Illustration Art: expanded between description and bottom -->
    <ImageView
        android:id="@+id/ivIntroIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:contentDescription="Illustration"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIntroDesc"
        tools:src="@drawable/intro_illustration_create_video" />

</androidx.constraintlayout.widget.ConstraintLayout>
