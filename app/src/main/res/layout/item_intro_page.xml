<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp">

    <!-- Top Icon Badge Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivIntroIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Intro Icon"
            tools:src="@drawable/icon_intro_1" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title -->
    <TextView
        android:id="@+id/tvIntroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/navy"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="Gom ảnh,\ntạo video" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvIntroDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/muted"
        android:textSize="14sp"
        tools:text="Biến những khoảnh khắc yêu thích thành video sống động chỉ trong vài giây." />

    <!-- Illustration Art -->
    <ImageView
        android:id="@+id/ivIntroIllustration"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:contentDescription="Illustration"
        android:scaleType="fitCenter"
        tools:src="@drawable/intro_illustration_create_video" />

</LinearLayout>
