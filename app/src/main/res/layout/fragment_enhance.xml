<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_create_screen">

    <!-- Top Bar: Back, Title "AI Create ✦", Heart Action -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_back"
            android:clickable="true"
            android:contentDescription="@string/btn_back"
            android:elevation="1dp"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#4A7BFE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack">

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/ai_create_title"
                android:textColor="#3A8BF5"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivTopTitleSparkle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Sparkle"
                android:src="@drawable/ic_sparkle_chip"
                app:tint="#6F86F4" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Body Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnGeneratePrompt"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Section 1 & 2 Container Card (White rounded card matching Figma) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="#EEF3FC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp">

                    <!-- Section 1: Nhập mô tả (Prompt) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Sparkle"
                            android:src="@drawable/ic_sparkle_chip"
                            app:tint="#7A63EE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="@string/enter_prompt_hint"
                            android:textColor="#5B7DF0"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_prompt_input">

                        <EditText
                            android:id="@+id/etPromptInput"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="@string/prompt_hint"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:maxLength="500"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="24dp"
                            android:textColor="#2B3990"
                            android:textColorHint="#A7B3E6"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPromptCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="14dp"
                            android:layout_marginBottom="10dp"
                            android:text="0/500"
                            android:textColor="#8A96C8"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <!-- Section 2: Gợi ý prompt -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Sparkle"
                            android:src="@drawable/ic_sparkle_chip"
                            app:tint="#7A63EE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="@string/prompt_suggestions"
                            android:textColor="#5B7DF0"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Suggestions Grid (Row 1) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAnimeGirl"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_anime"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFantasy"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_fantasy"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCutePet"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_pet"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Suggestions Grid (Row 2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipCyberpunk"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_cyberpunk"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipNature"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_nature"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipPortrait"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="5dp"
                            android:drawableTint="#6F7CF2"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_portrait"
                            android:textColor="#5A72D8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Style -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Sparkle"
                    android:src="@drawable/ic_sparkle_chip"
                    app:tint="#7A63EE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/prompt_style"
                    android:textColor="#5B7DF0"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horizontal Style Cards -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Style 1: Cyber Move (Selected) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle1"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#7F8CF6"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/suggestion_ai_effect" />

                            <!-- Bottom Gradient Scrim for text readability -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <!-- Hot Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_gravity="top|start"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_hot"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="7dp"
                                android:paddingEnd="8dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="Flame"
                                    android:src="@drawable/ic_flame" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="Hot"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Style Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Cyber Move"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 2: Street Vibes -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle2"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/transparent"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/suggestion_ai_dance" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Street Vibes"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 3: Urban Renaissance -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle3"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/transparent"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/template_trendy" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Urban\nRenaissance"
                                android:textColor="@color/white"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button: Tạo ảnh -->
    <LinearLayout
        android:id="@+id/btnGeneratePrompt"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        android:background="@drawable/bg_btn_ai_create"
        android:clickable="false"
        android:enabled="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Magic"
            android:src="@drawable/ic_wand_magic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_generate_image"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Arrow"
            android:src="@drawable/ic_arrow_forward_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
