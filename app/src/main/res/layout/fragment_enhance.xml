<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_create_screen">

    <!-- Top Bar: Common Header with Back, Title "AI Create", and Sparkle -->
    <com.example.phortart_video_990.core.view.CommonTabHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/ai_create_title"
        app:showBackButton="true"
        app:showSparkle="true"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Body Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnGeneratePrompt"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Section 1 & 2 Container Card (White rounded card matching Figma) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp">

                    <!-- Section 1: Nhập mô tả (Prompt) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Sparkle"
                            android:src="@drawable/ic_sparkle_chip"
                            app:tint="#3556D4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/enter_prompt_hint"
                            android:textColor="#3250C9"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_prompt_input">

                        <EditText
                            android:id="@+id/etPromptInput"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="@string/prompt_hint"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="24dp"
                            android:textColor="#102148"
                            android:textColorHint="#94A3B8"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvPromptCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="14dp"
                            android:layout_marginBottom="10dp"
                            android:text="0/500"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </FrameLayout>

                    <!-- Section 2: Gợi ý prompt -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Sparkle"
                            android:src="@drawable/ic_sparkle_chip"
                            app:tint="#3556D4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/prompt_suggestions"
                            android:textColor="#3250C9"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Suggestions Grid (Row 1) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAnimeGirl"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_anime"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFantasy"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_fantasy"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCutePet"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_pet"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Suggestions Grid (Row 2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipCyberpunk"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_cyberpunk"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipNature"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_nature"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipPortrait"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_prompt_chip"
                            android:drawableStart="@drawable/ic_sparkle_chip"
                            android:drawablePadding="4dp"
                            android:drawableTint="#5373F2"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/prompt_chip_portrait"
                            android:textColor="#3250C9"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Style -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Sparkle"
                    android:src="@drawable/ic_sparkle_chip"
                    app:tint="#3556D4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/prompt_style"
                    android:textColor="#3250C9"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horizontal Style Cards -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Style 1: Cyber Move (Selected) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle1"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/template_trendy" />

                            <!-- Bottom Gradient Scrim for text readability -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <!-- Hot Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_hot"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="3dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/prompt_badge_hot"
                                    android:textColor="@color/white"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Style Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Cyber Move"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 2: Street Vibes -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle2"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/transparent"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/history_3" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Street Vibes"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 3: Urban Renaissance -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStyle3"
                        android:layout_width="112dp"
                        android:layout_height="148dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/transparent"
                        app:strokeWidth="2.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStyle3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/suggestion_ai_portrait" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_style_scrim" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:text="Urban\nRenaissance"
                                android:textColor="@color/white"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button: Tạo ảnh -->
    <LinearLayout
        android:id="@+id/btnGeneratePrompt"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_ai_create"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Magic"
            android:src="@drawable/ic_wand_magic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_generate_image"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
