<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLanguage"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_item_language"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <!-- Perfectly Circular Flag Icon (42dp matching src) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFlag"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:strokeColor="#24283C82"
        app:strokeWidth="0.8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars"
        tools:ignore="ContentDescription" />

    <!-- Name & Subtitle -->
    <LinearLayout
        android:id="@+id/llLanguageInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivRadio"
        app:layout_constraintStart_toEndOf="@+id/imgFlag"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvLanguageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:textColor="#2A34C9"
            android:textSize="15.5sp"
            android:textStyle="bold"
            tools:text="Tiếng Việt" />

        <TextView
            android:id="@+id/tvLanguageSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:textColor="#A3AACB"
            android:textSize="12.5sp"
            tools:text="Vietnamese" />
    </LinearLayout>

    <!-- Radio Indicator (22dp matching src) -->
    <ImageView
        android:id="@+id/ivRadio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Selection"
        android:src="@drawable/bg_radio_unselected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
