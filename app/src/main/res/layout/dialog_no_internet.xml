<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:background="@drawable/bg_dialog_task_removal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Top Icon Badge (64dp, Blue #EEF2FF) -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_dialog_icon_badge_blue">

        <ImageView
            android:id="@+id/imgNoInternetIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_popup_no_internet"
            app:tint="#4A63E8"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Title "Mất kết nối Internet" -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/plus_jakarta_sans"
        app:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.015"
        android:lineHeight="28sp"
        app:lineHeight="28sp"
        android:text="@string/no_internet_title"
        android:textColor="#111827"
        android:textFontWeight="700"
        android:textSize="18sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/plus_jakarta_sans"
        app:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:lineHeight="20sp"
        app:lineHeight="20sp"
        android:text="@string/no_internet_desc"
        android:textColor="#64748B"
        android:textFontWeight="400"
        android:textSize="13sp" />

    <!-- Try Again Button -->
    <TextView
        android:id="@+id/btnTryAgain"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_dialog_primary"
        android:elevation="2dp"
        android:fontFamily="@font/plus_jakarta_sans"
        app:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:lineHeight="20sp"
        app:lineHeight="20sp"
        android:text="@string/btn_try_again"
        android:textColor="#FFFFFF"
        android:textFontWeight="600"
        android:textSize="14sp" />

    <!-- Dismiss Button -->
    <TextView
        android:id="@+id/btnDismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/plus_jakarta_sans"
        app:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:lineHeight="20sp"
        app:lineHeight="20sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/btn_dismiss"
        android:textColor="#64748B"
        android:textFontWeight="500"
        android:textSize="14sp" />

</LinearLayout>
