<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_restore_screen">

    <!-- Top Bar: Common Header with Back Button and Title -->
    <com.example.phortart_video_990.core.view.CommonTabHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/restoring_photo"
        app:showBackButton="true"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Content: Illustration, Circular Progress, and Status Texts -->
    <LinearLayout
        android:id="@+id/layoutCenterContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintVertical_bias="0.42">

        <!-- 3D Layered Illustration Block (Matching the Right Screen Mockup) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutIllustration"
            android:layout_width="144dp"
            android:layout_height="144dp">

            <!-- 1. Deep Blue Gradient Card BEHIND (Shifted Top-Left, 0 deg) -->
            <View
                android:id="@+id/cardBaseBlue"
                android:layout_width="96dp"
                android:layout_height="84dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="#334F7CFE"
                android:outlineSpotShadowColor="#334F7CFE"
                android:background="@drawable/bg_restore_hero_back_blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. Translucent Grey Frosted Glass Card IN FRONT (Rotated 7 deg clockwise) -->
            <FrameLayout
                android:id="@+id/cardFront"
                android:layout_width="96dp"
                android:layout_height="84dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:rotation="7"
                android:transformPivotX="48dp"
                android:transformPivotY="42dp"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="#266E78EC"
                android:outlineSpotShadowColor="#266E78EC"
                android:background="@drawable/bg_restore_hero_glass"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="Photo Frame"
                    android:src="@drawable/ic_restore_illustration_photo"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- 3. Comparison Badge with White Border & Double Arrows (Bottom-Right) -->
            <FrameLayout
                android:id="@+id/badgeCompare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="-10dp"
                android:layout_marginBottom="-10dp"
                android:elevation="10dp"
                android:outlineAmbientShadowColor="#666E64EB"
                android:outlineSpotShadowColor="#666E64EB"
                android:background="@drawable/bg_restore_compare_badge"
                app:layout_constraintBottom_toBottomOf="@+id/cardFront"
                app:layout_constraintEnd_toEndOf="@+id/cardFront">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Compare"
                    android:src="@drawable/ic_compare_arrows"
                    app:tint="#FFFFFF" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Circular Progress Ring with Center Percentage -->
        <FrameLayout
            android:id="@+id/layoutProgressRing"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="46dp">

            <com.example.phortart_video_990.ui.screen.feature.restore.widget.CircularProgressView
                android:id="@+id/progressCircle"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#102148"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="49%" />
        </FrameLayout>

        <!-- Status Texts -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:gravity="center"
            android:text="@string/restoring_photo_dots"
            android:textColor="#102148"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/loading_please_wait"
            android:textColor="#6F7E94"
            android:textSize="13.5sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
