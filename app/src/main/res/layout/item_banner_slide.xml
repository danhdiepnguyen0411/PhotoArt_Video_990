<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banner_bg_fallback">

    <ImageView
        android:id="@+id/ivBannerBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Banner"
        android:scaleType="centerCrop"
        tools:src="@drawable/banner_1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llBannerContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.65">

            <!-- Chip: Hidden to match Figma -->
            <TextView
                android:id="@+id/tvBannerChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- Title Line 1 (Dark Navy) -->
            <TextView
                android:id="@+id/tvBannerTitleLine1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_black"
                app:fontFamily="@font/inter_black"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="#16296B"
                android:textSize="16.5sp"
                tools:text="Gom ảnh" />

            <!-- Title Line 2 (Dark Navy + Gradient Highlight) -->
            <LinearLayout
                android:id="@+id/llTitleLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBannerTitleLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/inter_black"
                    app:fontFamily="@font/inter_black"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#16296B"
                    android:textSize="16.5sp"
                    tools:text="lưu trọn " />

                <TextView
                    android:id="@+id/tvBannerHighlight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_black"
                    app:fontFamily="@font/inter_black"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/banner_grad_start"
                    android:textSize="16.5sp"
                    tools:text="kỷ niệm" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tvBannerDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:textColor="#596B8E"
                android:textSize="11sp"
                tools:text="Chọn ảnh, thêm nhạc, tạo video." />

            <!-- Action Button (Rounded Gradient Pill) -->
            <TextView
                android:id="@+id/btnBannerAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_banner_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter_bold"
                android:textStyle="bold"
                tools:text="Tạo ngay" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
