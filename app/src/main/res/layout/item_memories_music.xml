<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_item_memories_music_unselected"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- 42dp rounded cover image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_func_music"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/Rounded10ImageView" />

    <!-- Song Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_bold"
        android:maxLines="1"
        android:textColor="#182E6E"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/flPlayAction"
        app:layout_constraintStart_toEndOf="@+id/ivCover"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Sunshine" />

    <!-- Play/Pause circle action button -->
    <FrameLayout
        android:id="@+id/flPlayAction"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_memories_play_circle_unselected"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivPlayIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="Play/Pause"
            android:src="@drawable/ic_play_small"
            app:tint="#6F64EE" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#6F64EE"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
