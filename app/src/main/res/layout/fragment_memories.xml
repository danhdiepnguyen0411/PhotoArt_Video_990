<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFE">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1E3A8A" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/memories_title"
            android:textColor="#203A87"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnCreateVideo"
        app:layout_constraintTop_toBottomOf="@+id/llTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Section 1: Ảnh của bạn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPhotosSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memories_upload_title"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/no_photos_selected"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_add_photo_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/add_photos_pill"
                    android:textColor="#3B82F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Box Container with 3 Polaroid Cards -->
            <FrameLayout
                android:id="@+id/cardPhotoStackContainer"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_photo_box_empty"
                android:clickable="true"
                android:focusable="true">

                <!-- Empty State Prompt (shown when 0 photos) -->
                <LinearLayout
                    android:id="@+id/llEmptyPhotosPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivEmptyPhotoIllustration"
                        android:layout_width="140dp"
                        android:layout_height="96dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/ic_empty_photo_illustration"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_select_photos"
                        android:textColor="#182E6E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/select_multiple_photos"
                        android:textColor="#7C8CA0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Polaroid Stack Container (shown when photos selected or previewing) -->
                <FrameLayout
                    android:id="@+id/flPolaroidStack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false">

                    <!-- Polaroid Left (tilted left -11 deg) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPolaroidLeft"
                        android:layout_width="125dp"
                        android:layout_height="155dp"
                        android:layout_gravity="center"
                        android:rotation="-11"
                        android:translationX="-42dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPolaroidLeft"
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Polaroid Right (tilted right +11 deg) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPolaroidRight"
                        android:layout_width="125dp"
                        android:layout_height="155dp"
                        android:layout_gravity="center"
                        android:rotation="11"
                        android:translationX="42dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPolaroidRight"
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Polaroid Center (in front, elevation 8dp, upright) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPolaroidCenter"
                        android:layout_width="138dp"
                        android:layout_height="172dp"
                        android:layout_gravity="center"
                        android:rotation="0"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="8dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPolaroidCenter"
                                android:layout_width="match_parent"
                                android:layout_height="128dp"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

            </FrameLayout>

            <!-- Section 2: Tỷ lệ khung hình -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_crop_badge"
                    android:contentDescription="Ratio"
                    android:padding="5dp"
                    android:src="@drawable/ic_crop_ratio" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/aspect_ratio_title"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Ratio 9:16 (Selected by default) -->
                <LinearLayout
                    android:id="@+id/btnRatio916"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aspect_ratio_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRatio916"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_ratio_9_16"
                        app:tint="#8B5CF6" />

                    <TextView
                        android:id="@+id/tvRatio916"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="9:16"
                        android:textColor="#8B5CF6"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Ratio 1:1 -->
                <LinearLayout
                    android:id="@+id/btnRatio11"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aspect_ratio_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRatio11"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_ratio_1_1"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvRatio11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="1:1"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Ratio 16:9 -->
                <LinearLayout
                    android:id="@+id/btnRatio169"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aspect_ratio_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRatio169"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_ratio_16_9"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvRatio169"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="16:9"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Section 3: Nhạc nền cho video -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/video_bg_music"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2EEFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_orange_music_icon">

                        <ImageView
                            android:id="@+id/ivMusicIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Music Icon"
                            android:src="@drawable/ic_music_note" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivMusicCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectedMusicTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lovely"
                            android:textColor="#132B68"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedMusicSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Billie Eilish • 03:20"
                            android:textColor="#8E9BB0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnChangeMusic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_change_music_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="@string/btn_change_music"
                        android:textColor="#3B82F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Create Video Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreateVideo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_create_video_pill"
        android:elevation="0dp"
        android:text="@string/btn_create_video_now"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
