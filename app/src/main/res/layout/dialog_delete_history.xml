<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:background="@drawable/bg_dialog_task_removal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Top Icon Badge (64dp, Red #FEE2E2) -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_dialog_icon_badge_red">

        <ImageView
            android:id="@+id/imgDeleteIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trash"
            app:tint="#DC2626"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Title "Xóa mục lịch sử" -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.015"
        android:text="Xóa mục lịch sử"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:lineSpacingExtra="2dp"
        android:text="Bạn có chắc chắn muốn xóa tác phẩm này khỏi danh sách lịch sử không? Hành động này không thể hoàn tác."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Delete Button -->
    <TextView
        android:id="@+id/btnConfirmDelete"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_dialog_red"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:text="Xóa"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/btnCancelDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Hủy"
        android:textColor="#64748B"
        android:textSize="14sp" />

</LinearLayout>
