<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0.5dp"
    app:cardPreventCornerOverlap="true"
    android:clipToOutline="true"
    app:strokeColor="#EFF2F7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/ivTemplateThumb"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Template Cover"
            android:scaleType="centerCrop"
            tools:src="@drawable/template_trendy" />

        <!-- Information Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Title with single line and end ellipsis -->
            <TextView
                android:id="@+id/tvTemplateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#1A243D"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Cùng nhau đi khắp th..." />

            <!-- Meta Row: Duration, Views, Photo count, Chevron -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Duration / Play Preview (Hidden) -->
                    <LinearLayout
                        android:id="@+id/llDurationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivPlayIcon"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:contentDescription="Play"
                            android:src="@drawable/ic_play_small"
                            app:tint="#8E9BB0" />

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="#8E9BB0"
                            android:textSize="11sp"
                            tools:text="00:16" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivViewsIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Views"
                        android:src="@drawable/ic_eye_small" />

                    <TextView
                        android:id="@+id/tvViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="#8E9BB0"
                        android:textSize="11sp"
                        tools:text="892,4K" />

                    <ImageView
                        android:id="@+id/ivPhotoIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Photos"
                        android:src="@drawable/ic_template_images"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPhotoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="#8E9BB0"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="5" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivArrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Arrow"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#CBD5E1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
