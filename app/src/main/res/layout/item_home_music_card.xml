<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="140dp"
    android:layout_height="194dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cover Container with Play Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="128dp">

            <ImageView
                android:id="@+id/ivMusicCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_orange_music_icon"
                android:contentDescription="Music Cover" />

            <!-- Soft bottom gradient on image for contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_banner_gradient_bottom" />

            <!-- Floating Mini Play Circle -->
            <FrameLayout
                android:id="@+id/flPlayButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_back_button"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/ivPlayIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_small"
                    app:tint="#7C3AED"
                    android:contentDescription="Play" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#7C3AED"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Genre pill tag on top start -->
            <TextView
                android:id="@+id/tvCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_category_chip_selected"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="EDM" />

        </FrameLayout>

        <!-- Track Title & Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvMusicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Future Phonk Bass" />

            <TextView
                android:id="@+id/tvMusicSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#64748B"
                android:textSize="11sp"
                tools:text="00:23 • Chọn ngay" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
