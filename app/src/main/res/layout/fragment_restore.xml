<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_restore_screen">

    <!-- Circular Back Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="999dp"
        app:cardElevation="3dp"
        app:cardPreventCornerOverlap="false"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_chevron_left" />
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnStartRestore"
        app:layout_constraintTop_toBottomOf="@+id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <!-- 3D Layered Illustration Block with Blue Under-Layer & Floating Badge -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutIllustration"
                android:layout_width="144dp"
                android:layout_height="144dp">

                <!-- 1. Deep Blue 3D Back Layer (Shifted Top-Left) -->
                <View
                    android:id="@+id/layerBackBlue"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_restore_back_layer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 2. Main Glassmorphic Photo Card Layer -->
                <FrameLayout
                    android:id="@+id/cardFront"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_restore_illustration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="Photo Frame"
                        android:src="@drawable/ic_restore_illustration_photo" />
                </FrameLayout>

                <!-- 3. Comparison Badge with White Border & Double Arrows (Bottom-Right) -->
                <FrameLayout
                    android:id="@+id/badgeCompare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-10dp"
                    android:layout_marginBottom="-6dp"
                    android:background="@drawable/bg_restore_compare_badge"
                    android:elevation="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/cardFront"
                    app:layout_constraintEnd_toEndOf="@+id/cardFront">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Compare"
                        android:src="@drawable/ic_compare_arrows" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Title: Khôi phục ảnh -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Khôi phục ảnh"
                android:textColor="#102148"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Biến những bức ảnh cũ, mờ, hư hỏng thành\nhình ảnh rõ nét, sống động hơn."
                android:textColor="#6F7E94"
                android:textSize="14sp" />

            <!-- Features Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <!-- Feature 1: Sửa ảnh mờ, nhòe -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="999dp"
                        app:cardElevation="3dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Sun Rays"
                            android:src="@drawable/ic_feature_sun_rays" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sửa ảnh mờ, nhòe"
                            android:textColor="#102148"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Làm rõ chi tiết, sắc nét hơn."
                            android:textColor="#8292A6"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Feature 2: Khôi phục ảnh cũ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="999dp"
                        app:cardElevation="3dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Old Photo"
                            android:src="@drawable/ic_feature_photo" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khôi phục ảnh cũ"
                            android:textColor="#102148"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Giảm nhiễu, cải thiện màu sắc."
                            android:textColor="#8292A6"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Feature 3: Tăng độ chân thực -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="999dp"
                        app:cardElevation="3dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="True Details"
                            android:src="@drawable/ic_feature_focus_lens" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tăng độ chân thực"
                            android:textColor="#102148"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Giữ nguyên vẻ tự nhiên của ảnh."
                            android:textColor="#8292A6"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button: Bắt đầu ngay -> -->
    <LinearLayout
        android:id="@+id/btnStartRestore"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_start_restore"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bắt đầu ngay"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Next"
            android:src="@drawable/ic_arrow_forward_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
