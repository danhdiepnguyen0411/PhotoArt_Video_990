<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_restore_screen">

    <!-- Circular Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_back"
        android:clickable="true"
        android:contentDescription="@string/btn_back"
        android:elevation="4dp"
        android:outlineAmbientShadowColor="#5A6EC8"
        android:outlineSpotShadowColor="#5A6EC8"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#2D7DF6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnStartRestore"
        app:layout_constraintTop_toBottomOf="@+id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- 3D Layered Hero Illustration Block (Matching Design Spec) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutIllustration"
                android:layout_width="180dp"
                android:layout_height="150dp">

                <!-- 0. Radial Glow Halo Behind -->
                <View
                    android:id="@+id/glowHalo"
                    android:layout_width="168dp"
                    android:layout_height="146dp"
                    android:background="@drawable/bg_restore_hero_glow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 1. Deep Blue Gradient Card BEHIND (Shifted Top-Left, 0 deg) -->
                <View
                    android:id="@+id/cardBaseBlue"
                    android:layout_width="112dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#334F7CFE"
                    android:outlineSpotShadowColor="#334F7CFE"
                    android:background="@drawable/bg_restore_hero_back_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 2. Translucent Grey Frosted Glass Card IN FRONT (Rotated 7 deg clockwise) -->
                <FrameLayout
                    android:id="@+id/cardFront"
                    android:layout_width="112dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="22dp"
                    android:rotation="7"
                    android:transformPivotX="56dp"
                    android:transformPivotY="50dp"
                    android:elevation="6dp"
                    android:outlineAmbientShadowColor="#266E78EC"
                    android:outlineSpotShadowColor="#266E78EC"
                    android:background="@drawable/bg_restore_hero_glass"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="Photo Frame"
                        android:src="@drawable/ic_restore_illustration_photo"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <!-- 3. Comparison Badge with White Border & Double Arrows (Bottom-Right) -->
                <FrameLayout
                    android:id="@+id/badgeCompare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-14dp"
                    android:layout_marginBottom="-14dp"
                    android:elevation="10dp"
                    android:outlineAmbientShadowColor="#666E64EB"
                    android:outlineSpotShadowColor="#666E64EB"
                    android:background="@drawable/bg_restore_compare_badge"
                    app:layout_constraintBottom_toBottomOf="@+id/cardFront"
                    app:layout_constraintEnd_toEndOf="@+id/cardFront">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Compare"
                        android:src="@drawable/ic_compare_arrows"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Title: Khôi phục ảnh -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/restore_title"
                android:textColor="#17327C"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:lineSpacingExtra="3.5dp"
                android:text="@string/restore_main_desc"
                android:textColor="#7A8FB8"
                android:textSize="14sp" />

            <!-- Features Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <!-- Feature 1: Sửa ảnh mờ, nhòe -->
                <LinearLayout
                    android:id="@+id/itemFeature1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/layoutFeatureIcon1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="4dp"
                        android:outlineAmbientShadowColor="#40646EC8"
                        android:outlineSpotShadowColor="#40646EC8"
                        android:background="@drawable/bg_feature_icon">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Sun Rays"
                            android:src="@drawable/ic_feature_sun_rays" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_feature_1_title"
                            android:textColor="#1B2A8C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/restore_feature_1_desc"
                            android:textColor="#8296BC"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Feature 2: Khôi phục ảnh cũ -->
                <LinearLayout
                    android:id="@+id/itemFeature2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/layoutFeatureIcon2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="4dp"
                        android:outlineAmbientShadowColor="#40646EC8"
                        android:outlineSpotShadowColor="#40646EC8"
                        android:background="@drawable/bg_feature_icon">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Old Photo"
                            android:src="@drawable/ic_feature_photo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_feature_2_title"
                            android:textColor="#1B2A8C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/restore_feature_2_desc"
                            android:textColor="#8296BC"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Feature 3: Tăng độ chân thực -->
                <LinearLayout
                    android:id="@+id/itemFeature3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/layoutFeatureIcon3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="4dp"
                        android:outlineAmbientShadowColor="#40646EC8"
                        android:outlineSpotShadowColor="#40646EC8"
                        android:background="@drawable/bg_feature_icon">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="True Details"
                            android:src="@drawable/ic_feature_focus_lens" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_feature_3_title"
                            android:textColor="#1B2A8C"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/restore_feature_3_desc"
                            android:textColor="#8296BC"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button: Bắt đầu ngay -->
    <LinearLayout
        android:id="@+id/btnStartRestore"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_start_restore"
        android:clickable="true"
        android:elevation="8dp"
        android:outlineAmbientShadowColor="#7878F0"
        android:outlineSpotShadowColor="#7878F0"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_now"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Arrow"
            android:src="@drawable/ic_arrow_forward_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
