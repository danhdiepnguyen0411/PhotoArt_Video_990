<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Track Cover / Music Art -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/banner_bg_fallback"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivTrackCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Track Cover"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_func_music" />

                <!-- Semi-transparent overlay with music note badge -->
                <ImageView
                    android:id="@+id/ivCoverMusicBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_media_badge"
                    android:padding="3dp"
                    android:src="@drawable/ic_filter_music"
                    app:tint="@color/primary"
                    android:contentDescription="Audio indicator" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Track Title & Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title with Marquee support -->
            <TextView
                android:id="@+id/tvTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Future Bass Cyberpunk EDM Remix" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTrackCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_chip_unselected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="EDM" />

                <TextView
                    android:id="@+id/tvTrackDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    tools:text="0:30" />

            </LinearLayout>

        </LinearLayout>

        <!-- Play/Pause Preview Button -->
        <FrameLayout
            android:id="@+id/btnPlayPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_category_chip_unselected"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivPlayIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_small"
                app:tint="@color/navy"
                android:contentDescription="Play Preview" />

            <ProgressBar
                android:id="@+id/pbPreviewLoading"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Select / Apply Track Button -->
        <FrameLayout
            android:id="@+id/btnSelectContainer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_music_select"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp">

            <TextView
                android:id="@+id/btnSelectTrack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Chọn"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbSelectLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
