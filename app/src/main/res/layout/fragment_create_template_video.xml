<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Bar: Header with Back Button and Gradient Title "Tạo video" -->
    <com.aiart.photo.beauti.editor.core.view.CommonTabHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/dance_video_title"
        app:showBackButton="true"
        app:centerTitle="true"
        app:showSparkle="false"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCreateDanceVideo"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp">

            <!-- 1. Section: Tải ảnh lên từ thư viện -->
            <TextView
                android:id="@+id/tvUploadTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/dance_upload_title"
                android:textColor="#16296B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Single Photo Box (Matching VIDEO_762Y4 layout & natural aspect ratio fit) -->
            <FrameLayout
                android:id="@+id/layoutSinglePhoto"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_upload_photo_box"
                android:clickable="true"
                android:focusable="true">

                <!-- Default Empty State -->
                <LinearLayout
                    android:id="@+id/layoutSingleEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivSingleUploadIcon"
                        android:layout_width="130dp"
                        android:layout_height="88dp"
                        android:contentDescription="Upload Illustration"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_magic_wand" />

                    <TextView
                        android:id="@+id/tvSingleUploadTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/dance_upload_card_title"
                        android:textColor="#16296B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSingleUploadTypes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/dance_upload_single_desc"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Selected Photo Preview State (Fit to 210dp upload area with natural aspect ratio) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSinglePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivSingleSelectedPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="Selected Photo"
                        android:scaleType="fitCenter" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- 2. Section: Chọn template -->
            <TextView
                android:id="@+id/tvTemplateSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/dance_select_template"
                android:textColor="#16296B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Category Chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTemplateCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_template_category_chip" />

            <!-- Horizontal Carousel of Templates -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTemplates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_dance_template_picker" />

            <!-- 3. Section: Nhạc nền -->
            <TextView
                android:id="@+id/tvMusicSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/dance_bg_music"
                android:textColor="#16296B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Music Category Chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMusicCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_template_category_chip" />

            <!-- Vertical List of Music Tracks -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMusicTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_dance_music_picker" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Button: "Tạo video" -->
    <LinearLayout
        android:id="@+id/btnCreateDanceVideo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.5"
        android:background="@drawable/bg_btn_create_dance_gradient"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="@string/btn_create_dance_video"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
