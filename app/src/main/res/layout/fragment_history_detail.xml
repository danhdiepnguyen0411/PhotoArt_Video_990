<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Bar: Common Header with Back Button, Title, and Right Actions -->
    <com.example.phortart_video_990.core.view.CommonTabHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/history_detail_title"
        app:showBackButton="true"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Detail Body -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Media Preview Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMediaContainer"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2ECFB"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Standard Image View (for Prompt AI, Gom ảnh thumbnail, etc.) -->
                    <ImageView
                        android:id="@+id/ivDetailMedia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Media"
                        android:scaleType="centerCrop" />

                    <!-- Before / After Slider for Khôi phục type -->
                    <com.example.phortart_video_990.ui.screen.feature.restore.widget.BeforeAfterSliderView
                        android:id="@+id/sliderView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- In-app Video Player -->
                    <VideoView
                        android:id="@+id/videoViewDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <!-- Play Button Overlay for Videos -->
                    <FrameLayout
                        android:id="@+id/flPlayOverlay"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_btn_pro"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="Play"
                            android:src="@drawable/ic_play_small"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/pbDetailLoading"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#4A63E8"
                        android:visibility="gone" />

                    <!-- Type Tag Badge Top-Left -->
                    <TextView
                        android:id="@+id/tvMediaTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_media_badge_capsule"
                        android:fontFamily="@font/inter_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/history_detail_ai_image"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <!-- Duration Badge Bottom-Right (for Videos) -->
                    <TextView
                        android:id="@+id/tvVideoDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_template_duration"
                        android:fontFamily="@font/inter_bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="00:15"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Title & Date -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#1B286F"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Lâu đài kỳ ảo bay giữa bầu trời thần tiên" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Date"
                    android:src="@drawable/ic_calendar"
                    app:tint="#8C9CB9" />

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#8C9CB9"
                    android:textSize="12sp"
                    tools:text="11 thg 10, 2026 • 01:31" />
            </LinearLayout>

            <!-- SECTION A: Prompt AI Info Card (Only visible for Prompt AI) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromptSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F7FAFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDEBFC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Prompt"
                            android:src="@drawable/ic_filter_sparkle"
                            app:tint="#3B82F6" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:text="@string/history_detail_prompt_used"
                            android:textColor="#1E3A8A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCopyPrompt"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_category_chip_unselected"
                            android:fontFamily="@font/inter_bold"
                            android:paddingHorizontal="10dp"
                            android:text="@string/btn_copy"
                            android:textAllCaps="false"
                            android:textColor="#2563EB"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPromptContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_white"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:textColor="#334155"
                        android:textSize="12.5sp"
                        tools:text="Lâu đài kỳ ảo bay giữa bầu trời thần tiên, ánh nắng hoàng hôn ảo diệu, phong cách Anime rực rỡ" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION B: Music / Montage Info Card (Only visible for Gom ảnh / Video) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMusicSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F7FAFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDEBFC"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_setting_icon_pink">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Music"
                                android:src="@drawable/ic_note_music"
                                app:tint="#EC4899" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMusicTrackTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:textColor="#1B286F"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                tools:text="Nhạc: Lumen Phonk (Slowed)" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter"
                                android:text="@string/history_detail_beat_sync"
                                android:textColor="#8C9CB9"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION C: Restore Info Card (Only visible for Khôi phục) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRestoreSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F0FDF4"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCFCE7"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_setting_icon_green">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Restore"
                                android:src="@drawable/ic_filter_restore"
                                app:tint="#10B981" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/history_detail_restore_high"
                                android:textColor="#065F46"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter"
                                android:text="@string/history_detail_restore_desc"
                                android:textColor="#059669"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFF3FA"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Secondary Action (Dùng lại / Tạo mới) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRecreate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_share_outline"
                android:fontFamily="@font/inter_bold"
                android:text="@string/btn_create_similar"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Primary Action: Save to Device -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveMedia"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_setting_iap"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:text="@string/btn_save_to_device"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
