<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header: Công cụ AI ✨ -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_ai_tools_title"
            android:textColor="#1E3A8A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_ai_tools_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />

        <!-- Cards Container Grid -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvHeaderSubtitle">

            <!-- Card 01: Gom kỷ niệm (Tall Card - Left) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card01Memories"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/card03Enhance"
                app:layout_constraintEnd_toStartOf="@+id/card04Music"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/card04Music">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <!-- Badge 01 -->
                    <TextView
                        android:id="@+id/badge01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_01"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="01"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Center Icon / Illustration -->
                    <ImageView
                        android:id="@+id/ivIcon01"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/func_01_memories"
                        android:src="@drawable/ic_func_memories"
                        app:layout_constraintBottom_toTopOf="@+id/llBottom01"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badge01" />

                    <!-- Bottom Title & Arrow -->
                    <LinearLayout
                        android:id="@+id/llBottom01"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/func_01_memories"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_arrow"
                            android:contentDescription="Open"
                            android:padding="5dp"
                            android:src="@drawable/ic_arrow_right" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 04: Ghép nhạc (Middle Top) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card04Music"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toTopOf="@+id/card03Enhance"
                app:layout_constraintEnd_toStartOf="@+id/card02Restore"
                app:layout_constraintStart_toEndOf="@+id/card01Memories"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <!-- Badge 04 -->
                    <TextView
                        android:id="@+id/badge04"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_04"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="04"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Center Icon -->
                    <ImageView
                        android:id="@+id/ivIcon04"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/func_04_music"
                        android:src="@drawable/ic_func_music"
                        app:layout_constraintBottom_toTopOf="@+id/llBottom04"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badge04" />

                    <!-- Bottom Info -->
                    <LinearLayout
                        android:id="@+id/llBottom04"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/func_04_music"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_arrow"
                            android:contentDescription="Open"
                            android:padding="4dp"
                            android:src="@drawable/ic_arrow_right" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 02: Khôi phục ảnh (Right Top) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card02Restore"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toTopOf="@+id/card05Upscale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card04Music"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <!-- Badge 02 -->
                    <TextView
                        android:id="@+id/badge02"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_02"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="02"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Center Icon -->
                    <ImageView
                        android:id="@+id/ivIcon02"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/func_02_restore"
                        android:src="@drawable/ic_func_restore"
                        app:layout_constraintBottom_toTopOf="@+id/llBottom02"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badge02" />

                    <!-- Bottom Info -->
                    <LinearLayout
                        android:id="@+id/llBottom02"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/func_02_restore"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_arrow"
                            android:contentDescription="Open"
                            android:padding="4dp"
                            android:src="@drawable/ic_arrow_right" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 03: Làm nét (Middle Bottom) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card03Enhance"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/card05Upscale"
                app:layout_constraintStart_toEndOf="@+id/card01Memories"
                app:layout_constraintTop_toBottomOf="@+id/card04Music">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <!-- Badge 03 -->
                    <TextView
                        android:id="@+id/badge03"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_03"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="03"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Center Icon -->
                    <ImageView
                        android:id="@+id/ivIcon03"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/func_03_enhance"
                        android:src="@drawable/ic_func_enhance"
                        app:layout_constraintBottom_toTopOf="@+id/llBottom03"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badge03" />

                    <!-- Bottom Info -->
                    <LinearLayout
                        android:id="@+id/llBottom03"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/func_03_enhance"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_arrow"
                            android:contentDescription="Open"
                            android:padding="4dp"
                            android:src="@drawable/ic_arrow_right" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 05: Nâng cấp ảnh (Right Bottom) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card05Upscale"
                android:layout_width="0dp"
                android:layout_height="140dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card03Enhance"
                app:layout_constraintTop_toBottomOf="@+id/card02Restore">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <!-- Badge 05 -->
                    <TextView
                        android:id="@+id/badge05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_05"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="05"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Center Icon -->
                    <ImageView
                        android:id="@+id/ivIcon05"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/func_05_upscale"
                        android:src="@drawable/ic_func_upscale"
                        app:layout_constraintBottom_toTopOf="@+id/llBottom05"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badge05" />

                    <!-- Bottom Info -->
                    <LinearLayout
                        android:id="@+id/llBottom05"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/func_05_upscale"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_arrow"
                            android:contentDescription="Open"
                            android:padding="4dp"
                            android:src="@drawable/ic_arrow_right" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
