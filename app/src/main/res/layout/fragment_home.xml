<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Header: Logo Brand + PRO Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="44dp"
            android:paddingBottom="14dp">

            <!-- Brand Logo & App Name -->
            <LinearLayout
                android:id="@+id/llBrandContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivBrandLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/photo_ai_logo" />

                <TextView
                    android:id="@+id/tvBrandPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="Photo"
                    android:textColor="#1B2A78"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvBrandAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="AI"
                    android:textColor="#3D86F4"
                    android:textSize="26sp" />
            </LinearLayout>

            <!-- PRO Button -->
            <LinearLayout
                android:id="@+id/btnPro"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_pro"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="PRO"
                    android:src="@drawable/ic_crown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="PRO"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Banner Carousel Container (Rounded Card + Bottom Dots inside) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBannerWrapper"
                android:layout_width="match_parent"
                android:layout_height="336dp"
                app:cardBackgroundColor="@color/banner_bg_fallback"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpBanners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Smooth Morphing Indicator -->
            <com.example.phortart_video_990.ui.screen.home.BannerIndicatorView
                android:id="@+id/bannerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/cvBannerWrapper"
                app:layout_constraintEnd_toEndOf="@+id/cvBannerWrapper"
                app:layout_constraintStart_toStartOf="@+id/cvBannerWrapper" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3 Core Feature Cards (0.64 Aspect Ratio, Centered 3D Icons, Soft Pastel Gradient) -->
        <LinearLayout
            android:id="@+id/llFeatureCards"
            android:layout_width="match_parent"
            android:layout_height="182dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Feature 1: Gom ảnh tạo video (Tone Violet) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFeatureVideo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_feature_violet"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp">

                <!-- 3D Art Icon Centered at Top -->
                <ImageView
                    android:id="@+id/ivFeatureVideo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Create Video"
                    android:scaleType="fitCenter"
                    android:src="@drawable/feature_create_video"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Feature Title -->
                <TextView
                    android:id="@+id/tvFeatureVideoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/feature_video_title"
                    android:textColor="#16296B"
                    android:textSize="13.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivFeatureVideo" />

                <!-- Circular White Arrow Badge at Bottom Right -->
                <FrameLayout
                    android:id="@+id/flArrowVideo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_feature_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="2dp">

                    <ImageView
                        android:id="@+id/ivArrowVideo"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Next"
                        android:src="@drawable/ic_arrow_right_feature"
                        app:tint="#6A4FE0" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Feature 2: Tạo ảnh prompt AI (Tone Blue) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFeaturePrompt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_feature_blue"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp">

                <!-- 3D Art Icon Centered at Top -->
                <ImageView
                    android:id="@+id/ivFeaturePrompt"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="AI Prompt"
                    android:scaleType="fitCenter"
                    android:src="@drawable/feature_ai_prompt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Feature Title -->
                <TextView
                    android:id="@+id/tvFeaturePromptTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/feature_prompt_title"
                    android:textColor="#16296B"
                    android:textSize="13.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivFeaturePrompt" />

                <!-- Circular White Arrow Badge at Bottom Right -->
                <FrameLayout
                    android:id="@+id/flArrowPrompt"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_feature_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="2dp">

                    <ImageView
                        android:id="@+id/ivArrowPrompt"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Next"
                        android:src="@drawable/ic_arrow_right_feature"
                        app:tint="#3D86F4" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Feature 3: Hồi sinh ảnh cũ (Tone Mint) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFeatureRestore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_feature_mint"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp">

                <!-- 3D Art Icon Centered at Top -->
                <ImageView
                    android:id="@+id/ivFeatureRestore"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Restore Photo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/feature_restore_photo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Feature Title -->
                <TextView
                    android:id="@+id/tvFeatureRestoreTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/feature_restore_title"
                    android:textColor="#16296B"
                    android:textSize="13.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivFeatureRestore" />

                <!-- Circular White Arrow Badge at Bottom Right -->
                <FrameLayout
                    android:id="@+id/flArrowRestore"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_feature_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="2dp">

                    <ImageView
                        android:id="@+id/ivArrowRestore"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Next"
                        android:src="@drawable/ic_arrow_right_feature"
                        app:tint="#1BB57A" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- Section 1: Lịch sử gần đây -->
        <LinearLayout
            android:id="@+id/llRecentHistorySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Clock"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="@string/home_recent_history"
                        android:textColor="#17237A"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSeeAllHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:text="@string/home_see_all"
                        android:textColor="#3D6FE8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#3D6FE8" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                tools:listitem="@layout/item_home_media_card" />

        </LinearLayout>

        <!-- Section 2: Gợi ý chủ đề cho bạn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Star"
                        android:src="@drawable/ic_star_section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="@string/home_suggestions"
                        android:textColor="#17237A"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSeeAllSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:text="@string/home_see_all"
                        android:textColor="#3D6FE8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#3D6FE8" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                tools:listitem="@layout/item_home_media_card" />

        </LinearLayout>

        <!-- Section 3: Template hot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Flame"
                        android:src="@drawable/ic_flame" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="@string/home_hot_templates"
                        android:textColor="#17237A"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSeeAllTemplates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:text="@string/home_see_all"
                        android:textColor="#3D6FE8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#3D6FE8" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHotTemplates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                tools:listitem="@layout/item_home_media_card" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
