<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/ivLanguageBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/intro_bg"
        android:contentDescription="@null" />

    <!-- Top Header - chiều cao cố định để không bị giật khi đổi ngôn ngữ -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="42dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nav Row with Back Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clNavHeader"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_back"
                android:contentDescription="@string/btn_back"
                android:elevation="1dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#2D7DF6"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLanguageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/language_title"
                android:textColor="#2D7DF6"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvLanguageDesc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/language_choose_desc"
            android:textColor="#7B8EB5"
            android:textSize="13.5sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Language List with smooth fading edge -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLanguages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="108dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader"
        tools:listitem="@layout/item_language" />

    <!-- Bottom Gradient Fade Scrim (Loại bỏ đường cắt cứng, tạo hiệu ứng mờ dần mềm mại) -->
    <View
        android:id="@+id/vBottomFadeScrim"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="@drawable/bg_language_fade_bottom"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Confirm Button (Elevated on top of the bottom fade scrim with shadow) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="36dp"
        android:alpha="0.5"
        android:clickable="true"
        android:focusable="true"
        android:enabled="false"
        app:cardCornerRadius="27dp"
        app:cardElevation="6dp"
        app:cardMaxElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConfirmText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/btn_confirm"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivConfirmArrow"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward_white"
                android:contentDescription="@null" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Animated Click Hand GIF Tutorial Overlay (from 600Y_TREE_SCAN) -->
    <ImageView
        android:id="@+id/ivHandGif"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:elevation="16dp"
        android:translationZ="16dp"
        android:src="@drawable/click"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
