<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0.5dp"
    app:cardPreventCornerOverlap="true"
    android:clipToOutline="true"
    app:strokeColor="#EFF2F7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Solid light gray block for thumbnail with rounded top corners -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_skeleton_thumb" />

        <!-- Info container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- Title placeholder line -->
            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_bar_title" />

            <!-- Meta placeholder line -->
            <View
                android:layout_width="72dp"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_skeleton_bar_meta" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
