<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fullscreen Video Image Stage -->
    <ImageView
        android:id="@+id/ivFullscreenPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Center Play/Pause button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnFullscreenPlayPause"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        app:cardBackgroundColor="#80000000"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/ivFullscreenPlayPauseIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_small"
            app:tint="#FFFFFF" />
    </androidx.cardview.widget.CardView>

    <!-- Top Overlay: Close Button -->
    <ImageView
        android:id="@+id/btnFullscreenClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF" />

    <!-- Bottom Scrim Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim" />

    <!-- Bottom Progress & Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFullscreenTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="00:08 / 00:24"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFullscreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Tạo video kỷ niệm"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/fullscreenProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="330"
            android:progressDrawable="@drawable/bg_video_progress_bar" />
    </LinearLayout>

</FrameLayout>
