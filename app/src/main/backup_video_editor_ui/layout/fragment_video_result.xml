<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FE">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/navy" />

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Tạo video kỷ niệm"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nút Lưu trên Header -->
        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lưu"
            android:padding="9dp"
            android:src="@drawable/ic_download"
            app:tint="@color/navy" />

        <!-- Nút Chia sẻ trên Header -->
        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chia sẻ"
            android:padding="9dp"
            android:src="@drawable/ic_share_line"
            app:tint="@color/navy" />

    </LinearLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/llBottomActionBar"
        app:layout_constraintTop_toBottomOf="@+id/llTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 1. VIDEO PREVIEW STAGE (Card với nền xanh dương nhẹ) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVideoStage"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardBackgroundColor="#EDF3FD"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Inner Video Box (tỉ lệ 9:16 dọc ở giữa màn hình) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardInnerVideoFrame"
                        android:layout_width="155dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginVertical="6dp"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivStagePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                tools:src="@tools:sample/backgrounds/scenic" />

                            <!-- Bottom dark gradient for time & scrubber readability -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_bottom_scrim" />

                            <!-- Center Circular Play/Pause Button -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnPlayPause"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                app:cardBackgroundColor="#CCFFFFFF"
                                app:cardCornerRadius="22dp"
                                app:cardElevation="4dp">

                                <ImageView
                                    android:id="@+id/ivPlayPauseIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_play_small"
                                    app:tint="#4A4FE0" />
                            </androidx.cardview.widget.CardView>

                            <!-- Scrubber & Time Bar at bottom of video -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:paddingHorizontal="8dp"
                                android:paddingBottom="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvVideoTime"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:shadowColor="#80000000"
                                        android:shadowDx="0"
                                        android:shadowDy="1"
                                        android:shadowRadius="3"
                                        android:text="00:08 / 00:24"
                                        android:textColor="#FFFFFF"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/btnFullscreen"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_fullscreen"
                                        app:tint="#FFFFFF" />
                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/videoProgressBar"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="3dp"
                                    android:max="1000"
                                    android:progress="330"
                                    android:progressDrawable="@drawable/bg_video_progress_bar" />
                            </LinearLayout>

                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                </FrameLayout>
            </androidx.cardview.widget.CardView>


            <!-- 2. CARD: ẢNH CỦA BẠN (HORIZONTAL STRIP) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_feature_photo"
                            app:tint="#4A65ED" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Ảnh của bạn"
                            android:textColor="#162B55"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Badge số ảnh: "6 ảnh" -->
                        <TextView
                            android:id="@+id/tvPhotosBadgeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="6 ảnh"
                            android:textColor="#4A65ED"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Nút Sắp xếp -->
                        <LinearLayout
                            android:id="@+id/btnSortPhotos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_dropdown"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_sort"
                                app:tint="#5B6D8D" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Sắp xếp"
                                android:textColor="#5B6D8D"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_chevron_right"
                                android:rotation="90"
                                app:tint="#5B6D8D" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Horizontal photo list with "Thêm ảnh" button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvResultPhotos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_result_photo_strip" />

                        <!-- Button "+ Thêm ảnh" (Dashed Border) -->
                        <LinearLayout
                            android:id="@+id/btnAddMorePhotosInResult"
                            android:layout_width="54dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_btn_add_photo_dashed"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_add"
                                app:tint="#4A65ED" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Thêm ảnh"
                                android:textColor="#4A65ED"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- 3. CARD: NHẠC NỀN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_note_music"
                            app:tint="#4A65ED" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Nhạc nền"
                            android:textColor="#162B55"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Nút Đổi nhạc -->
                        <LinearLayout
                            android:id="@+id/btnChangeMusic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_note_music"
                                app:tint="#162B55" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Đổi nhạc"
                                android:textColor="#162B55"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Music Details Card Inner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_dropdown"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <!-- Album art / Thumbnail -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivMusicArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bg_thumb_gradient" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Title + Waveform -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTrackTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Memories – Piano version"
                                android:textColor="#162B55"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrackSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Soft Piano • 00:32"
                                android:textColor="#8296BC"
                                android:textSize="11.5sp" />

                            <!-- Audio Waveform Graphic -->
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:layout_marginTop="4dp"
                                android:scaleType="fitStart"
                                android:src="@drawable/ic_audio_waveform" />
                        </LinearLayout>

                        <!-- Circular Play Music Button -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnMusicPlayPreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="#EDF1FC"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivMusicPlayIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_small"
                                app:tint="#4A65ED" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- 4. CARD: HIỆU ỨNG CHUYỂN ẢNH -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_feature_focus_lens"
                            app:tint="#4A65ED" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Hiệu ứng chuyển ảnh"
                            android:textColor="#162B55"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Transition effect controls row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_dropdown"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp">

                        <!-- Effect Selector Dropdown: "Mờ dần" -->
                        <LinearLayout
                            android:id="@+id/btnSelectTransitionEffect"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Mini icon -->
                            <View
                                android:layout_width="24dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_chip_pill" />

                            <TextView
                                android:id="@+id/tvTransitionEffectName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Mờ dần"
                                android:textColor="#162B55"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_right"
                                android:rotation="90"
                                app:tint="#8296BC" />
                        </LinearLayout>

                        <!-- Vertical divider line -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="#DCE4F5" />

                        <!-- Switch: Áp dụng cho tất cả -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Áp dụng cho tất cả"
                            android:textColor="#5B6D8D"
                            android:textSize="12sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchApplyAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Fixed at bottom) -->
    <LinearLayout
        android:id="@+id/llBottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Info specs subtitle: "24 giây • 9:16 • HD v" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_video_camera_line"
                app:tint="#4A65ED" />

            <TextView
                android:id="@+id/tvVideoSpecs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="24 giây  •  9:16  •  HD"
                android:textColor="#5B6D8D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="90"
                app:tint="#5B6D8D" />
        </LinearLayout>

        <!-- Nút Tạo video to ở dưới -->
        <FrameLayout
            android:id="@+id/btnCreateVideoBottom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_badge_wand"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tạo video"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Overlay khi đang xuất video MP4 -->
    <FrameLayout
        android:id="@+id/flExportLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.cardview.widget.CardView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/pbExport"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="#4A4FE0" />

                <TextView
                    android:id="@+id/tvExportStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Đang xuất video..."
                    android:textColor="#193980"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExportPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0%"
                    android:textColor="#8296BC"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
